<%
  var categories = page.categories && page.categories.toArray ? page.categories.toArray() : [];
  var tags = page.tags && page.tags.toArray ? page.tags.toArray() : [];
  var tocEnabled = !theme.post || theme.post.toc !== false;
  var hasToc = tocEnabled && /<h[2-4][\s>]/i.test(page.content || '');
  var showUpdated = !theme.post || theme.post.show_updated !== false;
  var wasUpdated = page.updated && page.date && (new Date(page.updated).getTime() - new Date(page.date).getTime() > 86400000);
%>
<article class="article-page">
  <header class="article-header shell narrow-shell">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="<%= url_for('/') %>">首页</a><span aria-hidden="true">/</span>
      <% if (categories.length) { %><a href="<%= url_for(categories[0].path) %>"><%= categories[0].name %></a><span aria-hidden="true">/</span><% } %>
      <span aria-current="page">文章</span>
    </nav>
    <% if (categories.length) { %><a class="article-kicker" href="<%= url_for(categories[0].path) %>"><%= categories[0].name %></a><% } else { %><span class="article-kicker">FIELD NOTE</span><% } %>
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p class="article-deck"><%= page.description %></p><% } %>
    <div class="article-meta">
      <div><span>发布于</span><time datetime="<%= new Date(page.date).toISOString() %>"><%= format_date(page.date) %></time></div>
      <% if (showUpdated && wasUpdated) { %><div><span>更新于</span><time datetime="<%= new Date(page.updated).toISOString() %>"><%= format_date(page.updated) %></time></div><% } %>
      <div><span>阅读</span><strong><%= reading_time(page.content) %> 分钟 · <%= word_count(page.content) %> 字</strong></div>
    </div>
  </header>

  <div class="article-rule shell" aria-hidden="true"><span></span><i></i></div>

  <div class="article-layout shell<%= hasToc ? ' has-toc' : '' %>">
    <div class="post-content" data-post-content>
      <%- page.content %>
    </div>
    <% if (hasToc) { %>
      <aside class="toc-panel" aria-label="文章目录">
        <div class="toc-inner">
          <span class="toc-title"><%= (theme.post && theme.post.toc_title) || '本文目录' %></span>
          <%- toc(page.content, { list_number: false, min_depth: 2, max_depth: 3 }) %>
        </div>
      </aside>
    <% } %>
  </div>

  <footer class="article-footer shell narrow-shell">
    <% if (tags.length) { %>
      <div class="tag-row" aria-label="文章标签">
        <span>TAGGED</span>
        <% tags.forEach(function (tag) { %><a href="<%= url_for(tag.path) %>">#<%= tag.name %></a><% }); %>
      </div>
    <% } %>
    <div class="author-note">
      <div class="author-monogram" aria-hidden="true"><%= ((theme.profile && theme.profile.name) || config.author || 'T').slice(0, 1) %></div>
      <div><span>WRITTEN BY</span><strong><%= (theme.profile && theme.profile.name) || config.author || config.title %></strong><p><%= (theme.profile && theme.profile.bio) || config.description %></p></div>
    </div>

    <% if (page.prev || page.next) { %>
      <nav class="post-navigation" aria-label="相邻文章">
        <% if (page.prev) { %><a href="<%= url_for(page.prev.path) %>" rel="prev"><span>← 上一篇</span><strong><%= page.prev.title %></strong></a><% } else { %><span></span><% } %>
        <% if (page.next) { %><a href="<%= url_for(page.next.path) %>" rel="next"><span>下一篇 →</span><strong><%= page.next.title %></strong></a><% } %>
      </nav>
    <% } %>
  </footer>
</article>
